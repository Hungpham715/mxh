# MXH Graph-only NLP chatbot — COPY to chatbot/.env and edit locally.
# NEVER COMMIT real credentials. Use ONE of the profiles below.

# PROFILE A — recommended for first run, NO external services
APP_MODE=fake
GRAPH_PROVIDER=fake
LLM_PROVIDER=fake

# PROFILE B — CPU Qwen base with Neo4j AuraDB
# APP_MODE=real
# GRAPH_PROVIDER=neo4j
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3:0.6b
# NEO4J_URI=neo4j+s://YOUR_INSTANCE.databases.neo4j.io
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=REPLACE_ME_LOCALLY
# NEO4J_DATABASE=neo4j
# NEO4J_SCOPE_ID=nlpgraph-v1

# PROFILE C — After SFT LoRA; CPU base+local adapter via PEFT
# APP_MODE=real
# GRAPH_PROVIDER=neo4j
# LLM_PROVIDER=hf_cpu
# HF_MODEL_ID=Qwen/Qwen3-0.6B
# MODEL_ADAPTER_PATH=/absolute/path/to/saved_lora_adapter
# DEVICE=cpu
# USE_ADAPTER=true
# HF_HOME=/absolute/path/to/huggingface_cache
# HUGGING_FACE_TOKEN=  # OPTIONAL; only gated/private HF or approved upload

# Shared options for any profile
API_HOST=127.0.0.1
API_PORT=8000
WEB_PORT=5173
FRONTEND_ORIGIN=http://localhost:5173
MAX_ITERATIONS=5
MAX_RECORDS_PER_QUERY=20
MAX_GRAPH_HOPS=4
REQUEST_TIMEOUT_SECONDS=120
OLLAMA_TIMEOUT_SECONDS=120
DEBUG_TRACES=true
ENABLE_SSE=true
LANGSMITH_TRACING=false
ENABLE_EXTERNAL_LLM_AUGMENT=false
LOG_LEVEL=INFO
